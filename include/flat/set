// -*- C++ -*-

#pragma once

#include <functional>
#include <algorithm>
#include <vector>
#include "sorted_base.h"

namespace flat {

// a fast small set. Use if small (<32 elements) or iteration speed is more important than
// modification speed
template <typename T, typename Compare = std::less<T>>
class set : public sorted_base<T, T, Compare> {
  using super_t = sorted_base<T, T, Compare>;
public:
  using super_t::super_t;

  int count(const T& p) const { return super_t::find_(p).second; }
  bool contains(const T& p) const { return super_t::find_(p).second; }

  typename super_t::const_reference min() const { return this->storage.front(); }
  typename super_t::const_reference max() const { return this->storage.back(); }
  typename super_t::const_reference singleton() const
  {
    if (super_t::size() != 1)
      throw std::out_of_range("Not a singleton set!");
    return this->storage.front();
  }

  template<class Pred>
  set filter(Pred&& pred) const {
    set res;
    super_t::filter_(res, std::move(pred));
    return res;
  }

  bool is_subset(const set& o) const {
    return std::includes(this->storage.begin(), this->storage.end(),
                         o.storage.begin(), o.storage.end());
  }

  set set_union(const set& o) const {
    set res;
    std::set_union(this->storage.begin(), this->storage.end(),
                   o.storage.begin(), o.storage.end(),
                   std::back_inserter(res.storage),
                   Compare{});
    return res;
  }

  set intersect(const set& o) const {
    set res;
    std::set_intersection(this->storage.begin(), this->storage.end(),
                          o.storage.begin(), o.storage.end(),
                          std::back_inserter(res.storage),
                          Compare{});
    return res;
  }

  set diff(const set& o) const {
    set res;
    std::set_difference(this->storage.begin(), this->storage.end(),
                        o.storage.begin(), o.storage.end(),
                        std::back_inserter(res.storage),
                        Compare{});
    return res;
  }
};

}
