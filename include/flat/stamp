// -*- C++ -*-
#pragma once

#include <iterator>
#include <cassert>

namespace flat {

class stamp {
  size_t version = 0;
  friend class check;
public:
  void invalidate() { ++version; }

  class test {
    const stamp *owner = nullptr;
    size_t version;
  public:
    test() = default;
    test(const stamp& stamp) noexcept { set(stamp); }
    bool valid() const noexcept {
      return owner->version == version;
    }
    bool valid(const stamp& stamp) const noexcept{
      return &stamp == owner && valid();
    }
    void set(const stamp& stamp) noexcept {
      owner = &stamp;
      version = stamp.version;
    }
    void reset(const stamp& stamp) noexcept {
      if (&stamp == owner)
        owner = nullptr;
    }
    bool operator==(const test& o) const noexcept { return owner == o.owner && version == o.version; }
  };

  template<class It>
  class iterator {
    It it;
    test ch;
    void check() const {
      assert(ch.valid());
    }
    static void check(const iterator& l, const iterator& r) {
      assert(l.ch == r.ch && l.ch.valid());
    }
    typedef std::iterator_traits<It> iter_traits_t;

  public:
    typedef It iterator_type;
    typedef typename iter_traits_t::iterator_category iterator_category;
    typedef typename iter_traits_t::value_type value_type;
    typedef typename iter_traits_t::difference_type difference_type;
    typedef typename iter_traits_t::reference reference;
    typedef typename iter_traits_t::pointer pointer;

    iterator(const It& it, const test& ch): it(it), ch(ch) {}
    iterator(const iterator&) = default;
    const It& base() const { return it; }

    // forward iterator
    reference operator*() const { return check(), *it; }
    pointer operator->() const { return check(), std::addressof(*it); }
    iterator& operator++() { return check(), ++it, *this; }
    iterator operator++(int) { return check(), iterator(it++, ch); }
    friend bool operator==(const iterator& l, const iterator& r) { return check(l, r), l.it == r.it; }
    friend bool operator!=(const iterator& l, const iterator& r) { return check(l, r), l.it != r.it; }

    // bidirectional
    iterator& operator--() { return check(), --it, *this; }
    iterator operator--(int) { return check(), iterator(it--, ch); }

    // random access
    iterator& operator+=(difference_type n) { return check(), it += n, *this; }
    iterator& operator-=(difference_type n) { return check(), it -= n, *this; }
    iterator operator+(difference_type n) { return check(), iterator(it + n, ch); }
    iterator operator-(difference_type n) { return check(), iterator(it - n, ch); }
    reference operator[](difference_type n) { return check(), it[n]; }
    friend difference_type operator-(const iterator& l, const iterator& r) { return check(l, r), l.it - r.it; }
  };

  template<typename It>
  iterator<It> mkiter(It&& it) const { return iterator<It>(std::forward<It>(it), *this); }
};

}
